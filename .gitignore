data/.session
.session
*.session

# 真实玩家存档：本地调试用，不提交也不随部署上传
data/sample.save

# 本地日志与系统文件
*.log
.DS_Store
Thumbs.db
desktop.ini

# 环境变量
.env
.env.*

# 编辑器
.vscode/
.idea/

# 部署时附带的可下载安装包（构建产物，不进 git）
download/

# 免费额度的 DeepSeek Key：只在服务端读，绝不提交
